{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protected_paths.py\" vendored",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protected_paths.py\" backlog",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
