# Build context is the repository root; keep out what the demo never reads.
# .git stays out but for the three things that name the commit (task-0227): HEAD, refs and packed-refs;
# no objects, so the image can say its commit and a tag on it, not its distance from one
.git
!.git/HEAD
!.git/refs
!.git/packed-refs
.github
**/__pycache__
**/*.pyc
.pytest_cache
.venv
venv
backlog
tests
runs
# task-0245: a .env file holds the stack's settings, keys among them; compose reads one beside the compose file to
# fill in its variables, and none, at the root or in any folder, enters the image. A template with no values,
# .env.example, may.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
