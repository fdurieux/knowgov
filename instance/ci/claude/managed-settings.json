{
  "allowManagedHooksOnly": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/opt/knowgov/instance/ci/claude/knowgov_hook.py",
              "gate",
              "--task",
              "codegen",
              "--task-for",
              "spec=design",
              "--knowgov",
              "/opt/knowgov"
            ],
            "timeout": 600,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
