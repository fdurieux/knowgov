{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/fdurieux/knowgov/harness/schemas/proposal-impact.schema.json",
 "title": "knowgov proposal impact report",
 "description": "What `python harness/proposal_impact.py PROPOSAL -f json` prints and the MCP tool proposal_impact returns (task-0130, task-0131): a proposed addition read against the register as if approved, without approving it. Every overlay node, link and exception is hypothetical (const true) and read_as approved; nothing is stored (stored const false). Candidates carry their rule (D1-D4), their basis (authored or inferred) and the status proposed, never more; D5 is a placement finding. branch is null for a proposal held in the call and, in branch mode (task-0132, additive), names the checkout, the base, the merge base and head commits and what the diff holds that is not an addition. slices (task-0152, additive) is the slice map, one vertical slice per journey step by the register's thread walk. coverage reads every rule the register's checker defines (task-0241), and the schema names none (task-0261, a widening): before and after are keyed by the register's rule ids, each a coverage cell, and a new gap's rule is a rule id, so a register defining C5 needs no schema change and every earlier report still validates. Version 2 since task-0305 (not_followed and behind_not_followed, renamed from withdrawn: not additive); a change is additive or a new version. Exit 2 prints no report.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "tool",
  "register",
  "overlay",
  "as_of",
  "children_walked",
  "stored",
  "nodes",
  "links",
  "exceptions",
  "placement",
  "candidates",
  "coverage",
  "reach",
  "rests_on",
  "slices",
  "keys",
  "unmapped",
  "approvals",
  "limits",
  "branch"
 ],
 "$defs": {
  "marked": {
   "type": "object",
   "required": [
    "id",
    "hypothetical"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "hypothetical": {
     "type": "boolean"
    }
   }
  },
  "key": {
   "type": "object",
   "required": [
    "key",
    "owner",
    "anchor",
    "via"
   ],
   "additionalProperties": true,
   "description": "A landed register-map row as register_impact reports it: key, owner, anchor, via, not_followed when it rests only on a descendant not followed (task-0305; withdrawn means deprecated or retired alone); with a scenario held also level, stale, suspect and findings, the gate report's",
   "properties": {
    "key": {
     "type": "string"
    },
    "owner": {
     "type": [
      "string",
      "null"
     ]
    },
    "anchor": {
     "type": [
      "string",
      "null"
     ]
    },
    "via": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "not_followed": {
     "type": "boolean"
    },
    "level": {
     "type": "string"
    },
    "stale": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "suspect": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "findings": {
     "type": "array",
     "items": {
      "type": "object"
     }
    }
   }
  },
  "cell": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "kind",
    "name",
    "owner",
    "status"
   ],
   "description": "A node on a thread as the slice map shows it: new (an overlay node), changed (a reused node the proposal changes) or reused (any other register node)",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": [
      "string",
      "null"
     ]
    },
    "name": {
     "type": "string"
    },
    "owner": {
     "type": [
      "string",
      "null"
     ]
    },
    "status": {
     "enum": [
      "new",
      "reused",
      "changed"
     ]
    }
   }
  },
  "placed": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "element"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "element": {
     "enum": [
      "node",
      "link",
      "exception"
     ]
    },
    "slices": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "unsliced_key": {
   "type": "object",
   "required": [
    "key",
    "owner",
    "anchor",
    "via",
    "mapped",
    "nodes"
   ],
   "additionalProperties": true,
   "description": "A task-class key on no slice (task-0252): key, owner and anchor from its register-map rows (null when none), via empty, mapped false when no row names it, the nodes its rows name; with a scenario held also level, stale, suspect and findings, as a slice's rows",
   "properties": {
    "key": {
     "type": "string"
    },
    "owner": {
     "type": [
      "string",
      "null"
     ]
    },
    "anchor": {
     "type": [
      "string",
      "null"
     ]
    },
    "via": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "not_followed": {
     "type": "boolean"
    },
    "level": {
     "type": "string"
    },
    "stale": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "suspect": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "findings": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "mapped": {
     "type": "boolean"
    },
    "nodes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "rule_id": {
   "type": "string",
   "pattern": "^C[0-9]+$",
   "description": "a coverage rule's id as the register's checker names it in its COVERAGE_RULES (C1 to C4 at ieam-register v0.2.13); the schema names none (task-0261)"
  },
  "coverage_cell": {
   "type": "object",
   "required": [
    "denominator",
    "covered",
    "excepted",
    "uncovered"
   ],
   "additionalProperties": false,
   "properties": {
    "denominator": {
     "type": "integer",
     "minimum": 0
    },
    "covered": {
     "type": "integer",
     "minimum": 0
    },
    "excepted": {
     "type": "integer",
     "minimum": 0
    },
    "uncovered": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/marked"
     }
    }
   },
   "description": "one coverage rule before or after: its denominator, how many are covered and excepted, and the uncovered elements, each marked hypothetical or not"
  }
 },
 "properties": {
  "schema_version": {
   "const": 2
  },
  "tool": {
   "const": "knowgov proposal_impact"
  },
  "register": {
   "type": "object",
   "required": [
    "tag",
    "commit"
   ],
   "additionalProperties": false,
   "properties": {
    "tag": {
     "type": "string"
    },
    "commit": {
     "type": "string"
    }
   }
  },
  "overlay": {
   "type": "object",
   "required": [
    "digest",
    "title",
    "nodes",
    "links",
    "reused",
    "exceptions"
   ],
   "additionalProperties": false,
   "properties": {
    "digest": {
     "type": "string"
    },
    "title": {
     "type": "string"
    },
    "nodes": {
     "type": "integer",
     "minimum": 0
    },
    "links": {
     "type": "integer",
     "minimum": 0
    },
    "reused": {
     "type": "integer",
     "minimum": 0
    },
    "exceptions": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "as_of": {
   "type": "string"
  },
  "children_walked": {
   "type": "boolean"
  },
  "stored": {
   "const": false
  },
  "nodes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "kind",
     "taxonomy",
     "name",
     "parent",
     "owner",
     "read_as",
     "hypothetical"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "taxonomy": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "parent": {
      "type": [
       "string",
       "null"
      ]
     },
     "owner": {
      "type": [
       "string",
       "null"
      ]
     },
     "read_as": {
      "const": "approved"
     },
     "hypothetical": {
      "const": true
     }
    }
   }
  },
  "links": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "type",
     "source",
     "target",
     "rationale",
     "owner",
     "read_as",
     "hypothetical"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "target": {
      "type": "string"
     },
     "rationale": {
      "type": "string"
     },
     "owner": {
      "type": [
       "string",
       "null"
      ]
     },
     "read_as": {
      "const": "approved"
     },
     "hypothetical": {
      "const": true
     }
    }
   }
  },
  "exceptions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "rule",
     "scope",
     "expires",
     "read_as",
     "hypothetical"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "rule": {
      "type": [
       "string",
       "null"
      ]
     },
     "scope": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "expires": {
      "type": "string"
     },
     "read_as": {
      "const": "approved"
     },
     "hypothetical": {
      "const": true
     }
    }
   }
  },
  "placement": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "level",
     "check",
     "element",
     "where",
     "message",
     "rule"
    ],
    "additionalProperties": false,
    "properties": {
     "level": {
      "enum": [
       "error",
       "warning",
       "info"
      ]
     },
     "check": {
      "type": "string"
     },
     "element": {
      "type": "string"
     },
     "where": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "rule": {
      "enum": [
       "D5",
       null
      ]
     }
    }
   }
  },
  "candidates": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "rule",
     "basis",
     "kind",
     "element",
     "link",
     "same_as",
     "pool",
     "stated",
     "status",
     "reason"
    ],
    "additionalProperties": false,
    "properties": {
     "rule": {
      "enum": [
       "D1",
       "D2",
       "D3",
       "D4"
      ]
     },
     "basis": {
      "enum": [
       "authored",
       "inferred"
      ]
     },
     "kind": {
      "enum": [
       "link",
       "reuse",
       "same_as",
       "pool"
      ]
     },
     "element": {
      "type": "string"
     },
     "link": {
      "type": [
       "object",
       "null"
      ],
      "required": [
       "type",
       "source",
       "target"
      ],
      "additionalProperties": false,
      "properties": {
       "type": {
        "type": "string"
       },
       "source": {
        "type": "string"
       },
       "target": {
        "type": "string"
       }
      }
     },
     "same_as": {
      "type": [
       "string",
       "null"
      ]
     },
     "pool": {
      "type": [
       "array",
       "null"
      ],
      "items": {
       "type": "string"
      }
     },
     "stated": {
      "type": "boolean"
     },
     "status": {
      "const": "proposed"
     },
     "reason": {
      "type": "string"
     }
    }
   }
  },
  "coverage": {
   "type": "object",
   "required": [
    "before",
    "after",
    "new_gaps"
   ],
   "additionalProperties": false,
   "properties": {
    "before": {
     "type": "object",
     "propertyNames": {
      "$ref": "#/$defs/rule_id"
     },
     "additionalProperties": {
      "$ref": "#/$defs/coverage_cell"
     },
     "description": "every coverage rule the register's checker defines, keyed by its id, in its order (task-0241, task-0261)"
    },
    "after": {
     "type": "object",
     "propertyNames": {
      "$ref": "#/$defs/rule_id"
     },
     "additionalProperties": {
      "$ref": "#/$defs/coverage_cell"
     },
     "description": "every coverage rule the register's checker defines, keyed by its id, in its order (task-0241, task-0261)"
    },
    "new_gaps": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "rule",
       "id",
       "hypothetical"
      ],
      "additionalProperties": false,
      "properties": {
       "rule": {
        "$ref": "#/$defs/rule_id"
       },
       "id": {
        "type": "string"
       },
       "hypothetical": {
        "type": "boolean"
       }
      }
     }
    }
   }
  },
  "reach": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "node",
     "name",
     "kind",
     "state",
     "owner",
     "mode",
     "declared",
     "changed",
     "before",
     "after",
     "added",
     "removed",
     "new_edges"
    ],
    "additionalProperties": false,
    "properties": {
     "node": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "kind": {
      "type": [
       "string",
       "null"
      ]
     },
     "state": {
      "type": [
       "string",
       "null"
      ]
     },
     "owner": {
      "type": [
       "string",
       "null"
      ]
     },
     "mode": {
      "enum": [
       "as_is",
       "changed"
      ]
     },
     "declared": {
      "type": "boolean"
     },
     "changed": {
      "type": "boolean"
     },
     "before": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "after": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "added": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/marked"
      }
     },
     "removed": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "new_edges": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "from",
        "rel",
        "to",
        "live",
        "hypothetical"
       ],
       "additionalProperties": false,
       "properties": {
        "from": {
         "type": "string"
        },
        "rel": {
         "type": "string"
        },
        "to": {
         "type": "string"
        },
        "live": {
         "type": "boolean"
        },
        "hypothetical": {
         "type": "boolean"
        }
       }
      }
     }
    }
   }
  },
  "rests_on": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "node",
     "kind",
     "through",
     "via",
     "gap"
    ],
    "additionalProperties": false,
    "properties": {
     "node": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "through": {
      "type": "string"
     },
     "via": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "node",
        "hypothetical",
        "realisers"
       ],
       "additionalProperties": false,
       "properties": {
        "node": {
         "type": "string"
        },
        "hypothetical": {
         "type": "boolean"
        },
        "realisers": {
         "type": "array",
         "items": {
          "type": "string"
         }
        }
       }
      }
     },
     "gap": {
      "type": "boolean"
     }
    }
   }
  },
  "slices": {
   "type": "object",
   "additionalProperties": false,
   "description": "The slice map (task-0152, doc-0022 K1, additive): the register's thread walk with parent descent (ieam-register decision 0018) from each approved step of a journey that concerns a product in scope (a touchpoint under no step is its own), or, for a product no journey concerns, from each process that delivers it. The capabilities a product requires and no slice reaches are the register's A1 finding. Every overlay node, link and exception is placed once: in the one slice whose thread holds it, or in a named remainder group; elements gives the denominator. Facts only: no planning label, estimate or rank. With a scope (task-0191) the slices are the named journey's or product's own, the overlay may add nothing, and each slice carries its keys and cells.",
   "required": [
    "walk",
    "register_rule",
    "children",
    "products",
    "map",
    "remainder",
    "elements",
    "task_keys"
   ],
   "properties": {
    "walk": {
     "const": "thread"
    },
    "register_rule": {
     "const": "A1"
    },
    "children": {
     "const": true
    },
    "products": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "name",
       "status",
       "axis",
       "journeys",
       "processes",
       "slices",
       "not_walked",
       "required",
       "reached",
       "required_not_reached",
       "reached_not_required",
       "alignment_by"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "status": {
        "enum": [
         "new",
         "reused",
         "changed"
        ]
       },
       "axis": {
        "enum": [
         "step",
         "process"
        ]
       },
       "journeys": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "processes": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "slices": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "not_walked": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "required": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "reached": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "required_not_reached": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "reached_not_required": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "alignment_by": {
        "type": "string"
       }
      }
     }
    },
    "map": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "start",
       "axis",
       "products",
       "descendants",
       "thread",
       "empty",
       "not_followed",
       "owners",
       "elements",
       "handoffs",
       "keys"
      ],
      "properties": {
       "start": {
        "$ref": "#/$defs/cell"
       },
       "axis": {
        "enum": [
         "step",
         "process"
        ]
       },
       "products": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "descendants": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/cell"
        }
       },
       "thread": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "process",
         "capability",
         "application",
         "information"
        ],
        "properties": {
         "process": {
          "type": "array",
          "items": {
           "$ref": "#/$defs/cell"
          }
         },
         "capability": {
          "type": "array",
          "items": {
           "$ref": "#/$defs/cell"
          }
         },
         "application": {
          "type": "array",
          "items": {
           "$ref": "#/$defs/cell"
          }
         },
         "information": {
          "type": "array",
          "items": {
           "$ref": "#/$defs/cell"
          }
         }
        }
       },
       "empty": {
        "type": "array",
        "items": {
         "enum": [
          "process",
          "capability",
          "application",
          "information"
         ]
        }
       },
       "not_followed": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "from",
          "rel",
          "to",
          "state"
         ],
         "properties": {
          "from": {
           "type": "string"
          },
          "rel": {
           "type": "string"
          },
          "to": {
           "type": "string"
          },
          "state": {
           "type": [
            "string",
            "null"
           ]
          }
         }
        }
       },
       "owners": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "elements": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/placed"
        }
       },
       "handoffs": {
        "type": "array",
        "description": "each live thread edge whose two ends have different owners (task-0191): who hands over to whom along the slice",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "from",
          "rel",
          "to",
          "owners"
         ],
         "properties": {
          "from": {
           "type": "string"
          },
          "rel": {
           "type": "string"
          },
          "to": {
